<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/avium_card_background"
        android:outlineProvider="background"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/wallpaper_blur_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"     
            android:orientation="horizontal"
            android:paddingStart="24dp"           
            android:paddingEnd="24dp">         

            <ImageView
                android:id="@+id/avium_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/avium_settings_aboutphone_icon" />

            <ImageView
                android:id="@+id/avium_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:src="@drawable/avium_settings_aboutphone_text" />

        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
